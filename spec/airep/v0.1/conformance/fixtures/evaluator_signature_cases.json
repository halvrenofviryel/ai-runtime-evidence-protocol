        "profiles": {
          "key_trust": {"key_id": "producer-key-1"},
          "evaluator_signature": {
            "evaluator_id": "acme-audit", "evaluator_key_id": "evaluator-key-9",
            "signed_over": "sha256:5555555555555555555555555555555555555555555555555555555555555555",
            "verdict": "concur", "evaluated_at": "2026-05-30T06:00:00Z",
