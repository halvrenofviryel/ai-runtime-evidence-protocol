{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/halvrenofviryel/ai-runtime-evidence-protocol/main/spec/airep/v0.1/profiles/residual_capability_disposition.schema.json",
  "title": "ENAS residual-capability disposition (WP-SR)",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_type", "schema_version", "capability_id", "type", "issuer_or_source", "holder", "target", "scope", "authority", "creation_event", "affected_obligations", "credential_ref", "content_commitment", "current_state", "disposition_method", "responsible_principal", "deadline", "verification_method", "observer", "evidence", "result", "successor_obligation", "residual_risk", "claim_impact", "closure_claimed_complete"],
  "properties": {
    "profile_type": {"const": "residual_capability_disposition"},
    "schema_version": {"const": "enas-profile-0.1"},
    "capability_id": {"$ref": "#/$defs/id"},
    "type": {"type": "string", "minLength": 1},
    "issuer_or_source": {"$ref": "#/$defs/id"},
    "holder": {"$ref": "#/$defs/id"},
    "target": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "authority": {"type": "string", "minLength": 1},
    "creation_event": {"$ref": "#/$defs/id"},
    "affected_obligations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "credential_ref": {"type": "string", "minLength": 1},
    "content_commitment": {"$ref": "#/$defs/digest"},
    "current_state": {"enum": ["ACTIVE", "REVOKED", "EXPIRED", "REMOVED", "TRANSFERRED", "AUTHORIZED_RETAINED", "UNVERIFIED", "UNACCOUNTED"]},
    "disposition_method": {"type": "string", "minLength": 1},
    "responsible_principal": {"$ref": "#/$defs/id"},
    "deadline": {"type": "string", "minLength": 1},
    "verification_method": {"enum": ["AUTHORITATIVE_ACCESS_SYSTEM", "INDEPENDENT_OBSERVATION", "HOLDER_SELF_DECLARATION", "NONE"]},
    "observer": {"$ref": "#/$defs/id"},
    "evidence": {"$ref": "#/$defs/id"},
    "result": {"enum": ["CONFIRMED", "UNCONFIRMED", "INCONCLUSIVE"]},
    "successor_obligation": {"type": "string", "minLength": 1},
    "residual_risk": {"type": "string", "minLength": 1},
    "claim_impact": {"type": "string", "minLength": 1},
    "closure_claimed_complete": {"type": "boolean"}
  },
  "$defs": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
