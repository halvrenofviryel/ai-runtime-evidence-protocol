{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/halvrenofviryel/ai-runtime-evidence-protocol/main/spec/airep/v0.1/profiles/coverage_declaration.schema.json",
  "title": "ENAS coverage and negative-result declaration",
  "type": "object", "additionalProperties": false,
  "required": ["profile_type", "schema_version", "coverage_id", "claim_id", "assurance_surface_id", "baseline", "regions", "coverage_conclusion", "negative_result"],
  "properties": {
    "profile_type": {"const": "coverage_declaration"}, "schema_version": {"const": "enas-profile-0.1"}, "coverage_id": {"$ref": "#/$defs/id"}, "claim_id": {"$ref": "#/$defs/id"}, "assurance_surface_id": {"$ref": "#/$defs/id"},
    "baseline": {"type": "object", "additionalProperties": false, "required": ["source_class", "source_id", "separated_from_evaluator", "digest"], "properties": {"source_class": {"enum": ["SELF_DISCOVERED", "DECLARED", "INDEPENDENT"]}, "source_id": {"$ref": "#/$defs/id"}, "separated_from_evaluator": {"type": "boolean"}, "digest": {"$ref": "#/$defs/digest"}}},
    "regions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["region_id", "state", "evidence_refs"], "properties": {"region_id": {"$ref": "#/$defs/id"}, "state": {"enum": ["EXERCISED", "UNTESTED", "UNKNOWN", "EXCLUDED"]}, "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}}},
    "coverage_conclusion": {"enum": ["COMPLETE", "PARTIAL", "UNKNOWN"]},
    "negative_result": {"type": "object", "additionalProperties": false, "required": ["asserted", "observer_health", "evidence_channel_health", "unknown_region_ids", "statement"], "properties": {"asserted": {"type": "boolean"}, "observer_health": {"enum": ["HEALTHY", "UNHEALTHY", "NOT_MEASURED"]}, "evidence_channel_health": {"enum": ["HEALTHY", "UNHEALTHY", "NOT_MEASURED"]}, "unknown_region_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "statement": {"type": "string", "minLength": 1}}}
  },
  "$defs": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
