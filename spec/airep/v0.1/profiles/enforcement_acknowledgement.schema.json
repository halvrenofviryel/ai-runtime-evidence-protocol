{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/halvrenofviryel/ai-runtime-evidence-protocol/main/spec/airep/v0.1/profiles/enforcement_acknowledgement.schema.json",
  "title": "ENAS receiver-side enforcement acknowledgement",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_type", "schema_version", "enforcement_ack_id", "trace_id", "action_attempt_id", "decision_id", "instruction_id", "instruction_digest", "receiver_id", "enforcement_point_id", "deployment_instance", "result", "receiver_state_version", "channel_endpoint", "observed_at", "evidence_channel", "custody"],
  "properties": {
    "profile_type": {"const": "enforcement_acknowledgement"},
    "schema_version": {"const": "enas-profile-0.1"},
    "enforcement_ack_id": {"$ref": "#/$defs/id"},
    "trace_id": {"$ref": "#/$defs/id"},
    "action_attempt_id": {"$ref": "#/$defs/id"},
    "decision_id": {"$ref": "#/$defs/id"},
    "instruction_id": {"$ref": "#/$defs/id"},
    "instruction_digest": {"$ref": "#/$defs/digest"},
    "receiver_id": {"$ref": "#/$defs/id"},
    "enforcement_point_id": {"$ref": "#/$defs/id"},
    "deployment_instance": {"$ref": "#/$defs/id"},
    "result": {"enum": ["ACCEPTED", "REFUSED", "UNSUPPORTED_VERSION", "EXPIRED", "DUPLICATE", "ERROR"]},
    "receiver_state_version": {"$ref": "#/$defs/id"},
    "channel_endpoint": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "evidence_channel": {"$ref": "#/$defs/health"},
    "custody": {"enum": ["SAME_PROCESS", "SAME_TRUST_BOUNDARY", "SEPARATE_PROCESS", "SEPARATE_TRUST_BOUNDARY", "CONTROLLED_PARTY_WRITABLE"]},
    "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "health": {"type": "object", "additionalProperties": false, "required": ["id", "health"], "properties": {"id": {"$ref": "#/$defs/id"}, "health": {"enum": ["HEALTHY", "UNHEALTHY", "NOT_MEASURED"]}}}
  }
}
