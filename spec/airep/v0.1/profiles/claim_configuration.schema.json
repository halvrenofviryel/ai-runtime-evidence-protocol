{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/halvrenofviryel/ai-runtime-evidence-protocol/main/spec/airep/v0.1/profiles/claim_configuration.schema.json",
  "title": "ENAS assurance claim configuration (WP-CC)",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_type", "schema_version", "config_id", "config_digest", "identity_basis", "components"],
  "properties": {
    "profile_type": {"const": "claim_configuration"},
    "schema_version": {"const": "enas-profile-0.1"},
    "config_id": {"$ref": "#/$defs/id"},
    "config_digest": {"$ref": "#/$defs/digest"},
    "identity_basis": {"enum": ["CONTENT_ADDRESSED", "PRODUCT_NAME", "MUTABLE_VERSION_LABEL"]},
    "components": {"type": "object", "additionalProperties": false, "required": ["runtime_version", "model_descriptors", "policy_artifacts", "orchestration_logic", "tool_capabilities", "trust_boundaries", "data_sources", "profile_parameters"], "properties": {"runtime_version": {"type": "string", "minLength": 1}, "model_descriptors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "adapter_descriptors": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "policy_artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/digest_ref"}}, "prompt_artifacts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/digest_ref"}}, "orchestration_logic": {"$ref": "#/$defs/digest_ref"}, "tool_capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "credential_capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "deployment_topology": {"type": "string", "minLength": 1}, "trust_boundaries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "data_sources": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "profile_parameters": {"type": "object"}}}
  },
  "$defs": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "digest_ref": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "digest"], "properties": {"artifact_id": {"$ref": "#/$defs/id"}, "digest": {"$ref": "#/$defs/digest"}}}}
}
