{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/halvrenofviryel/ai-runtime-evidence-protocol/main/spec/airep/v0.1/profiles/origin_contract.schema.json",
  "title": "ENAS origin contract and obligation record (WP-OP)",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_type", "schema_version", "contract_id", "contract_version", "issuer", "authority_basis", "capability_boundary", "obligations", "authority_ceiling", "allowed_transformations", "completion_rule"],
  "properties": {
    "profile_type": {"const": "origin_contract"},
    "schema_version": {"const": "enas-profile-0.1"},
    "contract_id": {"$ref": "#/$defs/id"},
    "contract_version": {"type": "integer", "minimum": 1},
    "issuer": {"$ref": "#/$defs/id"},
    "authority_basis": {"type": "string", "minLength": 1},
    "capability_boundary": {"type": "object", "additionalProperties": false, "required": ["mediated_effects", "evidence_channels"], "properties": {"mediated_effects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "evidence_channels": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "obligations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["obligation_id", "kind", "statement", "assignment_mode", "lifecycle_state"], "properties": {"obligation_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["REQUIRE", "PRESERVE", "PROHIBIT", "VERIFY"]}, "statement": {"type": "string", "minLength": 1}, "assignment_mode": {"$ref": "#/$defs/assignment_mode"}, "lifecycle_state": {"$ref": "#/$defs/lifecycle_state"}, "predecessor_ref": {"$ref": "#/$defs/id"}, "successor_ref": {"$ref": "#/$defs/id"}}}},
    "authority_ceiling": {"type": "string", "minLength": 1},
    "allowed_transformations": {"type": "array", "uniqueItems": true, "items": {"enum": ["EXACT_REPRESENTATION", "STRUCTURAL_EQUIVALENCE", "SEMANTIC_BOUNDED", "AUTHORIZED_VARIATION"]}},
    "completion_rule": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "assignment_mode": {"enum": ["TRANSFER", "SUBTASK", "REPLICATE", "PARTITION", "COLLABORATE", "OBSERVE"]},
    "lifecycle_state": {"enum": ["OPEN", "DISCHARGED", "TRANSFORMED", "REVOKED", "FAILED", "UNRESOLVED"]}
  }
}
