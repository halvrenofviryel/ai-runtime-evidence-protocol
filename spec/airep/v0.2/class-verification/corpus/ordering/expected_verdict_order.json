  ],
  "first_expected": {
   "case_id": "ORD2",
   "final_scalar": "U+FF00",
   "final_scalar_utf16be_hex": "ff00",
   "final_scalar_utf8_hex": "efbc80",
   "record_id": "cv-rec-ord-＀",
   "record_id_utf8_hex": "63762d7265632d6f72642defbc80"
  },
  "note": "The corpus-directory order deliberately AGREES with the wrong (UTF-16) order, so emitting verdicts in directory order fails the same gate.",
  "purpose": "Separate UTF-8 byte order from JavaScript's native UTF-16 code-unit order. Code-point order and UTF-8 byte order agree for ALL valid Unicode scalar values (UTF-8 is order-preserving by construction), so UTF-16 code-unit order is the only one of the three that diverges: this fixture is a naive-JavaScript-sort detector, which is the requirement's real runtime risk.",
  "required_relative_order": [
   "ORD2",
   "ORD1"
  ],
  "second_expected": {
   "case_id": "ORD1",
   "final_scalar": "U+10000",
   "final_scalar_utf16be_hex": "d800dc00",
   "final_scalar_utf8_hex": "f0908080",
   "record_id": "cv-rec-ord-𐀀",
   "record_id_utf8_hex": "63762d7265632d6f72642df0908080"
  },
  "unicode_validity": "Both record_ids end in a valid Unicode SCALAR value. No lone surrogate is used anywhere in this corpus.",
  "utf16_reasoning": "In UTF-16 code units the first differing unit is ff00 against the high surrogate d800. 0xD800 < 0xFF00, so a native JavaScript string comparison yields ORD1 before ORD2 — the OPPOSITE order, and a detectable failure.",
  "utf8_reasoning": "The two record_ids share the prefix `cv-rec-ord-`; the first differing byte is ef (0xEF) against f0 (0xF0). 0xEF < 0xF0, so ORD2 precedes ORD1."
 },
