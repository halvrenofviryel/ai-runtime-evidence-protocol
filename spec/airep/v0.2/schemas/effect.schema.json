{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://raw.githubusercontent.com/halvrenofviryel/ai-runtime-evidence-protocol/main/spec/airep/v0.2/schemas/effect.schema.json",
 "title": "AIREP v0.2 Effect Evidence",
 "$comment": "Mechanical expression of the accepted ARTIFACT_SCHEMA_DESIGN contract; no implementation-invented constraints. Top-level closure via unevaluatedProperties (2020-12): common core properties are evaluated through the allOf, family members here; anything else is rejected.",
 "type": "object",
 "allOf": [
  {
   "$ref": "common.schema.json#/$defs/artifact_core"
  }
 ],
 "properties": {
  "artifact_type": {
   "const": "effect"
  },
  "decision_ref": {
   "$ref": "common.schema.json#/$defs/artifact_ref"
  },
  "execution_ref": {
   "$ref": "common.schema.json#/$defs/artifact_ref"
  },
  "observer_relationship": {
   "enum": [
    "same_executor",
    "independent",
    "unknown"
   ],
   "description": "Producer-declared at Core; verified independence is Authenticated+ semantic-verifier work (AD-03)."
  },
  "observed_state": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "description"
   ],
   "properties": {
    "description": {
     "type": "string"
    },
    "state_digest": {
     "$ref": "common.schema.json#/$defs/sha256_digest"
    }
   }
  },
  "evidence": {
   "$ref": "common.schema.json#/$defs/evidence_array"
  }
 },
 "required": [
  "decision_ref",
  "execution_ref",
  "observer_relationship",
  "observed_state"
 ],
 "unevaluatedProperties": false
}
