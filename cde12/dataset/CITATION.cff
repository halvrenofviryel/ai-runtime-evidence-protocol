    given-names: Ali Toygar
    orcid: "https://orcid.org/0009-0002-3718-4010"
version: "0.1"
date-released: "2026-07-27"
license: CC-BY-4.0
repository-code: "https://github.com/halvrenofviryel/ai-runtime-evidence-protocol"
url: "https://github.com/halvrenofviryel/ai-runtime-evidence-protocol/tree/main/cde12/dataset"
keywords:
