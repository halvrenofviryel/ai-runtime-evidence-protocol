{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "allOf": [
  {
   "description": "A row that states an agreement verdict must carry both result objects. Without this, a report could claim AGREE with both results null.",
   "if": {
    "properties": {
     "agreement": {
      "enum": [
       "AGREE",
       "DISAGREE"
      ]
     }
    },
    "required": [
     "agreement"
    ]
   },
   "then": {
    "properties": {
     "expected_result": {
      "type": "object"
     },
     "observed_result": {
      "type": "object"
     }
    }
   }
  },
  {
   "$comment": "RC-SYM-OBSERVED",
   "description": "A result that emits an AIREP class must carry all five reason channels. Without this, a verdict could be reported with reason_channels null - the exact collapse this package says is not permitted.",
   "if": {
    "properties": {
     "observed_result": {
      "properties": {
       "airep_class": {
        "type": "string"
       }
      },
      "required": [
       "airep_class"
      ],
      "type": "object"
     }
    },
    "required": [
     "observed_result"
    ]
   },
   "then": {
    "properties": {
     "observed_result": {
      "properties": {
       "reason_channels": {
        "required": [
         "authenticated_failures",
         "authenticated_withheld",
         "authenticated_caveats",
         "witnessed_failures",
         "witnessed_withheld"
        ],
        "type": "object"
       }
      }
     }
    }
   }
  },
  {
   "$comment": "RC-SYM-EXPECTED",
   "description": "Symmetric to RC-SYM-OBSERVED. A result that emits an AIREP class must carry all five reason channels, and that holds for the expected result as well as the observed one. An earlier schema constrained only observed_result, so a report could state an expected verdict with reason_channels null - the same collapse the observed side already rejected.",
   "if": {
    "properties": {
     "expected_result": {
      "properties": {
       "airep_class": {
        "type": "string"
       }
      },
      "required": [
       "airep_class"
      ],
      "type": "object"
     }
    },
    "required": [
     "expected_result"
    ]
   },
   "then": {
    "properties": {
     "expected_result": {
      "properties": {
       "reason_channels": {
        "required": [
         "authenticated_failures",
         "authenticated_withheld",
         "authenticated_caveats",
         "witnessed_failures",
         "witnessed_withheld"
        ],
        "type": "object"
       }
      }
     }
    }
   }
  },
  {
   "description": "A row stating an agreement verdict must identify what produced it.",
   "if": {
    "properties": {
     "agreement": {
      "enum": [
       "AGREE",
       "DISAGREE"
      ]
     }
    },
    "required": [
     "agreement"
    ]
   },
   "then": {
    "properties": {
     "implementation_digest": {
      "minLength": 1
     },
     "implementation_name": {
      "minLength": 1
     },
     "input_package_digest": {
      "minLength": 1
     }
    }
   }
  }
 ],
 "properties": {
  "adjudicator": {
   "type": [
    "string",
    "null"
   ]
  },
  "agreement": {
   "enum": [
    "AGREE",
    "DISAGREE",
    "NOT_RUN",
    "CANNOT_RUN",
    null
   ]
  },
  "case_id": {
   "type": "string"
  },
  "contribution_kind": {
   "description": "e.g. 'independent verifier run against an author-produced, release-pinned AIREP corpus'",
   "type": "string"
  },
  "corpus_digest": {
   "description": "sha256 of the distributed archive",
   "type": "string"
  },
  "corpus_name": {
   "const": "AIREP v0.2 Independent-Verifier Corpus"
  },
  "corpus_version": {
   "const": "0.2"
  },
  "does_not_establish": {
   "type": "string"
  },
  "expected_result": {
   "additionalProperties": false,
   "description": "A conforming result MUST keep the five outcome dimensions separate. Collapsing FAIL, WITHHELD and INDETERMINATE into one boolean is non-conforming.",
   "properties": {
    "airep_class": {
     "enum": [
      "AIREP-Core",
      "AIREP-Authenticated",
      "AIREP-Witnessed",
      null
     ]
    },
    "cryptographic_result": {
     "enum": [
      "PASS",
      "FAIL",
      "NOT_EVALUATED"
     ]
    },
    "observer_assessment": {
     "enum": [
      "same_executor",
      "independent",
      "unknown",
      "not_applicable",
      null
     ]
    },
    "process_exit": {
     "type": [
      "integer",
      "null"
     ]
    },
    "reason_channels": {
     "additionalProperties": false,
     "description": "null only when no verdict is emitted",
     "properties": {
      "authenticated_caveats": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "authenticated_failures": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "authenticated_withheld": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "witnessed_failures": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "witnessed_withheld": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "authenticated_failures",
      "authenticated_withheld",
      "authenticated_caveats",
      "witnessed_failures",
      "witnessed_withheld"
     ],
     "type": [
      "object",
      "null"
     ]
    },
    "run_validity": {
     "enum": [
      "VALID",
      "INVALID_CONFIGURATION",
      "INVALID_ARTIFACT"
     ]
    },
    "signing_input_reconstruction": {
     "enum": [
      "RECONSTRUCTED",
      "MISMATCH",
      "INDETERMINATE"
     ]
    }
   },
   "required": [
    "run_validity",
    "signing_input_reconstruction",
    "cryptographic_result",
    "airep_class",
    "reason_channels",
    "observer_assessment",
    "process_exit"
   ],
   "type": [
    "object",
    "null"
   ]
  },
  "expected_results_visible_before_implementation": {
   "type": [
    "boolean",
    "null"
   ]
  },
  "finding_classification": {
   "enum": [
    "none",
    "corpus_defect",
    "expected_result_defect",
    "implementation_defect",
    "specification_ambiguity",
    "capability_gap",
    "undetermined",
    null
   ]
  },
  "implementation_author": {
   "type": [
    "string",
    "null"
   ]
  },
  "implementation_digest": {
   "description": "commit or package digest",
   "type": "string"
  },
  "implementation_name": {
   "type": "string"
  },
  "implementation_source": {
   "type": "string"
  },
  "independent_reproducer": {
   "type": [
    "string",
    "null"
   ]
  },
  "input_package_digest": {
   "type": "string"
  },
  "inspected_first_party_verifier_code": {
   "description": "recorded by the implementer; nobody else can record it for them",
   "type": [
    "boolean",
    "null"
   ]
  },
  "normative_text_used": {
   "items": {
    "type": "string"
   },
   "type": "array"
  },
  "observed_result": {
   "additionalProperties": false,
   "description": "A conforming result MUST keep the five outcome dimensions separate. Collapsing FAIL, WITHHELD and INDETERMINATE into one boolean is non-conforming.",
   "properties": {
    "airep_class": {
     "enum": [
      "AIREP-Core",
      "AIREP-Authenticated",
      "AIREP-Witnessed",
      null
     ]
    },
    "cryptographic_result": {
     "enum": [
      "PASS",
      "FAIL",
      "NOT_EVALUATED"
     ]
    },
    "observer_assessment": {
     "enum": [
      "same_executor",
      "independent",
      "unknown",
      "not_applicable",
      null
     ]
    },
    "process_exit": {
     "type": [
      "integer",
      "null"
     ]
    },
    "reason_channels": {
     "additionalProperties": false,
     "description": "null only when no verdict is emitted",
     "properties": {
      "authenticated_caveats": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "authenticated_failures": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "authenticated_withheld": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "witnessed_failures": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "witnessed_withheld": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "authenticated_failures",
      "authenticated_withheld",
      "authenticated_caveats",
      "witnessed_failures",
      "witnessed_withheld"
     ],
     "type": [
      "object",
      "null"
     ]
    },
    "run_validity": {
     "enum": [
      "VALID",
      "INVALID_CONFIGURATION",
      "INVALID_ARTIFACT"
     ]
    },
    "signing_input_reconstruction": {
     "enum": [
      "RECONSTRUCTED",
      "MISMATCH",
      "INDETERMINATE"
     ]
    }
   },
   "required": [
    "run_validity",
    "signing_input_reconstruction",
    "cryptographic_result",
    "airep_class",
    "reason_channels",
    "observer_assessment",
    "process_exit"
   ],
   "type": [
    "object",
    "null"
   ]
  },
  "originator": {
   "type": [
    "string",
    "null"
   ]
  },
  "reconstruction_stages_attempted": {
   "additionalProperties": false,
   "properties": {
    "canonical_bytes": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "class_produced": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "hash_preimage": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "matched_integrity_current": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "parsed": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "reason_channels_produced": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "references_resolved": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "signature_preimage": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "signature_verified": {
     "type": [
      "boolean",
      "null"
     ]
    }
   },
   "type": "object"
  },
  "report_schema_version": {
   "const": "1"
  },
  "vouches_for": {
   "description": "exactly what this signer personally performed or checked",
   "items": {
    "type": "string"
   },
   "type": "array"
  }
 },
 "required": [
  "report_schema_version",
  "corpus_name",
  "corpus_version",
  "corpus_digest",
  "case_id",
  "contribution_kind",
  "implementation_name",
  "implementation_source",
  "implementation_digest",
  "normative_text_used",
  "inspected_first_party_verifier_code",
  "expected_results_visible_before_implementation",
  "input_package_digest",
  "reconstruction_stages_attempted",
  "observed_result",
  "expected_result",
  "agreement",
  "finding_classification",
  "does_not_establish",
  "originator",
  "implementation_author",
  "independent_reproducer",
  "adjudicator",
  "vouches_for"
 ],
 "title": "AIREP independent-verifier run report row",
 "type": "object"
}
